---
// Writing listing screen (05-design-spec.md §11 s04; T-023 AC1, AC2). Posts arrive already
// newest-first from `getPosts()` (content module, 03-platform-architecture.md §5), so this
// component only renders them in the order it receives. Topic filtering is the shared zero-JS
// `FilterList` pattern (ADR-009): each row is wrapped in an element carrying `data-topics`, the
// component's own `:has()` CSS does the rest. Falls back to the shared `EmptyState` when there
// are no posts yet (05-design-spec.md §8 "Empty state"); a filter matching zero posts is handled
// by `FilterList` itself, not here.
import { BaseLayout, EmptyState, FilterList, EntryRow } from "../layout";
import { formatYearMonth, localizePath, t, type Locale } from "../i18n";
import type { Post } from "../content";
import { isoDate } from "./isoDate";

interface Props {
  locale: Locale;
  posts: Post[];
  /** The current page's path, including any locale prefix it already has. */
  path: string;
}

const { locale, posts, path } = Astro.props;

const title = t(locale, "blog.pageTitle");
const description = t(locale, "blog.intro");

// Filter pills (05-design-spec.md §8 "Filter pill"): value matches the lowercased token a row's
// `data-topics` carries (built below from the post's own `topics`, case-insensitively).
const filterOptions = (["backend", "go", "ai", "architecture"] as const).map(
  (value) => {
    const label = t(locale, `filter.${value}`);
    return {
      value,
      label,
      emptyMessage: t(locale, "filter.emptyWriting").replace("{filter}", label),
    };
  },
);
---

<BaseLayout locale={locale} title={title} description={description} path={path}>
  <div class="container writing-listing">
    <section class="page-hero">
      <span class="eyebrow">{t(locale, "blog.eyebrow")}</span>
      <h1>{t(locale, "blog.heading")}</h1>
      <p class="lead">{t(locale, "blog.intro")}</p>
    </section>

    {posts.length === 0 ? (
      <EmptyState>{t(locale, "emptyState.posts")}</EmptyState>
    ) : (
      <FilterList
        id="writing-filter"
        groupLabel={t(locale, "filter.writingGroupLabel")}
        allLabel={t(locale, "filter.all")}
        options={filterOptions}
      >
        {posts.map((post) => {
          const contentLocale: Locale = post.isFallback ? "en" : locale;
          const topics = post.topics ?? [];
          return (
            <div
              data-topics={topics.map((topic) => topic.toLowerCase()).join(" ")}
              lang={post.isFallback ? "en" : undefined}
            >
              <EntryRow
                variant="writing"
                href={localizePath(`/blog/${post.slug}/`, locale)}
                date={formatYearMonth(post.date, contentLocale)}
                dateTime={isoDate(post.date)}
                title={post.title}
                description={post.summary}
                meta={topics}
              />
            </div>
          );
        })}
      </FilterList>
    )}
  </div>
</BaseLayout>

<style>
  .writing-listing {
    padding-top: var(--space-6);
    padding-bottom: var(--space-8);
  }
  .page-hero {
    max-width: 640px;
    margin-bottom: var(--space-6);
  }

  @media (max-width: 640px) {
    .page-hero h1 {
      font-size: 48px;
    }
  }
</style>
