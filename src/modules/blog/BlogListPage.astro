---
// Blog listing screen (05-design-spec.md §11 s04; T-013 AC1-AC4). Posts arrive already
// newest-first from `getPosts()` (content module, 03-platform-architecture.md §5), so this
// component only renders them in the order it receives — no re-sorting here. Falls back to the
// shared `EmptyState` when there are no posts yet (05-design-spec.md §13 empty-state wording).
import { BaseLayout, EmptyState } from "../layout";
import { formatDate, localizePath, t, type Locale } from "../i18n";
import type { Post } from "../content";
import { isoDate } from "./isoDate";

interface Props {
  locale: Locale;
  posts: Post[];
  /** The current page's path, including any locale prefix it already has. */
  path: string;
}

const { locale, posts, path } = Astro.props;

const title = "Blog — Matheus Nardi";
const description =
  locale === "pt-br"
    ? "Publicações sobre engenharia de software, por Matheus Nardi."
    : "Posts on software engineering, published by Matheus Nardi.";
---

<BaseLayout locale={locale} title={title} description={description} path={path}>
  <div class="container blog-listing">
    <span class="eyebrow">{t(locale, "eyebrow.blog")}</span>
    <h1>{t(locale, "nav.blog")}</h1>

    {posts.length === 0 ? (
      <EmptyState>{t(locale, "emptyState.posts")}</EmptyState>
    ) : (
      <ul class="post-list">
        {posts.map((post) => {
          const contentLocale: Locale = post.isFallback ? "en" : locale;
          return (
            <li lang={post.isFallback ? "en" : undefined}>
              <a href={localizePath(`/blog/${post.slug}/`, locale)}>
                <h2>{post.title}</h2>
                <time datetime={isoDate(post.date)} class="post-date">
                  {formatDate(post.date, contentLocale)}
                </time>
              </a>
            </li>
          );
        })}
      </ul>
    )}
  </div>
</BaseLayout>

<style>
  .blog-listing {
    padding-top: var(--space-6);
    padding-bottom: var(--space-8);
  }
  .post-list {
    list-style: none;
    margin: var(--space-6) 0 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .post-list li {
    border-bottom: 1px solid var(--color-border-default);
    padding-bottom: var(--space-5);
  }
  .post-list a {
    text-decoration: none;
    color: var(--color-text-primary);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .post-list a:hover h2 {
    color: var(--color-brand-text);
    text-decoration: underline;
  }
  .post-list h2 {
    margin: 0;
    font-size: var(--font-size-lg);
  }
  .post-date {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
  }
</style>
