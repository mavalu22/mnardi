---
// Article screen (05-design-spec.md §11 s05; T-023 AC3-AC5). Renders the article head (eyebrow
// "Writing / " + topics, title, meta line: month/year, reading time, optional updated date), the
// body in `Prose` beside a sticky `OnThisPage` index built from the body's own `##` headings, and
// (for a pt-BR page falling back to English, ADR-007) the fallback notice plus a `lang="en"`
// wrapper around the English content. Footer back/forward links come from `BaseLayout`'s
// `section="writing"` handling (Footer.astro), not from this component.
import { BaseLayout, FallbackNotice, Prose, OnThisPage } from "../layout";
import { formatMonthYear, t, type Locale } from "../i18n";
import { renderPost, readingMinutes, type Post } from "../content";
import { isoDate } from "./isoDate";

interface Props {
  post: Post;
  /** The current page's path, including any locale prefix it already has. */
  path: string;
}

const { post, path } = Astro.props;
const { locale } = post;
// The post's own language: English whenever this pt-BR page shows the English fallback
// (ADR-007), otherwise the page's locale.
const contentLocale: Locale = post.isFallback ? "en" : locale;
const rendered = await renderPost(post.slug, locale);
if (!rendered) {
  throw new Error(
    `PostPage: no renderable entry for slug "${post.slug}" (internal error)`,
  );
}
const { Content, headings } = rendered;

const topics = post.topics ?? [];
const eyebrowText = `${t(locale, "post.eyebrowPrefix")}${topics.join(" · ")}`;
const minutes = readingMinutes(post.body);
const readingText = `${minutes} ${t(locale, "readingTime.suffix")}`;
---

<BaseLayout
  locale={locale}
  title={`${post.title} — Matheus Nardi`}
  description={post.summary}
  path={path}
  fallback={post.isFallback}
  ogType="article"
>
  <div class="container article-page">
    {post.isFallback && (
      <div class="fallback-notice-wrap">
        <FallbackNotice>{t(locale, "fallbackNotice.message")}</FallbackNotice>
      </div>
    )}

    <span class="eyebrow">{eyebrowText}</span>

    <div lang={post.isFallback ? "en" : undefined}>
      <section class="article-head">
        <h1>{post.title}</h1>
        <p class="article-meta">
          <time datetime={isoDate(post.date)}>
            {formatMonthYear(post.date, contentLocale)}
          </time>
          <span aria-hidden="true"> · </span>
          <span>{readingText}</span>
          {post.updated && (
            <>
              <span aria-hidden="true"> · </span>
              <span>
                {t(locale, "post.updated")}{" "}
                <time datetime={isoDate(post.updated)}>
                  {formatMonthYear(post.updated, contentLocale)}
                </time>
              </span>
            </>
          )}
        </p>
      </section>

      <div class="article-body">
        <Prose>
          <Content />
        </Prose>
        <OnThisPage
          label={t(locale, "onThisPage.articleLabel")}
          headings={headings}
        />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .article-page {
    padding-top: var(--space-6);
    padding-bottom: var(--space-8);
  }
  .fallback-notice-wrap {
    margin-bottom: var(--space-5);
  }
  .article-head {
    max-width: 760px;
  }
  .article-meta {
    margin: var(--space-3) 0 0 0;
    font-family: var(--font-family-mono);
    font-size: var(--font-size-meta);
    color: var(--color-muted);
  }

  .article-body {
    display: grid;
    grid-template-columns: minmax(0, 760px) 240px;
    gap: var(--space-7);
    margin-top: var(--space-6);
  }

  @media (max-width: 940px) {
    .article-body {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .article-head h1 {
      font-size: 48px;
    }
  }
</style>
