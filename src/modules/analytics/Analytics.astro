---
// The Umami tracker tag (ADR-005, ADR-008). Rendered only when the build-time
// `PUBLIC_UMAMI_WEBSITE_ID` variable is set, which happens only in Vercel's
// Production environment (03-platform-architecture.md §6, §9), so local dev
// and preview builds emit no reference to Umami at all.
import { PUBLIC_UMAMI_WEBSITE_ID } from "astro:env/client";
---

{PUBLIC_UMAMI_WEBSITE_ID && (
  <script
    defer
    src="https://cloud.umami.is/script.js"
    data-website-id={PUBLIC_UMAMI_WEBSITE_ID}
    data-domains="mnardi.com"
  />
)}
