---
// Shared page shell: head metadata (title, description, canonical, hreflang
// alternates, Open Graph tags), skip link, header, <main> and footer
// (03-platform-architecture.md §4, §8; 05-design-spec.md §12). Every page
// renders through this layout.
import { alternates, localizePath, t, type Locale } from "../i18n";
import { siteProfile } from "../site";
import { Analytics } from "../analytics";
import Header from "./components/Header.astro";
import Footer from "./components/Footer.astro";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** The current page's path, including any locale prefix it already has. */
  path: string;
  /**
   * True when this page's main content is an English fallback served at a
   * pt-BR URL (ADR-007): the canonical URL points at the English page and no
   * pt-BR hreflang alternate is emitted, so search engines don't index the
   * pt-BR URL as a duplicate of content that isn't actually translated.
   */
  fallback?: boolean;
  ogType?: "website" | "article";
}

const {
  locale,
  title,
  description,
  path,
  fallback = false,
  ogType = "website",
} = Astro.props;

const allAlternates = alternates(path);

/**
 * Which primary-nav section `path` belongs to (05-design-spec.md §8 "Header", §12
 * semantics): drives `aria-current="page"` on the matching nav link and which footer
 * variant renders (§8 "Footer"). Derived from the path itself (locale prefix and all)
 * so every caller — including the pages T-012-T-014 shipped before this task and that
 * this task doesn't otherwise touch — gets the right section with no prop to pass.
 */
type Section = "home" | "projects" | "writing";
function sectionFor(pagePath: string): Section {
  const localeNeutral = pagePath.replace(/^\/pt-br(\/|$)/, "/");
  if (/^\/projects(\/|$)/.test(localeNeutral)) return "projects";
  if (/^\/blog(\/|$)/.test(localeNeutral)) return "writing";
  return "home";
}
const section = sectionFor(path);

const currentHref = `${siteProfile.siteUrl}${localizePath(path, locale)}`;
const htmlLang =
  allAlternates.find(
    (alternate) =>
      alternate.href === currentHref && alternate.hreflang !== "x-default",
  )?.hreflang ?? locale;

const canonicalLocale: Locale = fallback ? "en" : locale;
const canonicalHref = `${siteProfile.siteUrl}${localizePath(path, canonicalLocale)}`;

const ptBrHref = `${siteProfile.siteUrl}${localizePath(path, "pt-br")}`;
const headAlternates = fallback
  ? allAlternates.filter((alternate) => alternate.href !== ptBrHref)
  : allAlternates;
---

<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalHref} />
    {headAlternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate.hreflang}
        href={alternate.href}
      />
    ))}
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

    {/*
      Theme toggle, part 1 of 2 (03-platform-architecture.md §8;
      05-design-spec.md §2/§8): runs before first paint so a stored explicit
      choice applies with no flash of the wrong theme, and marks <html> as
      script-capable so the toggle button (hidden by default CSS) can appear.
      This script's text must stay byte-for-byte identical on every page and
      in both locales (T-017 allowlists it in a CSP by SHA-256 hash), so it
      contains no interpolated value.
    */}
    <script is:inline>
      (function () {
        const d = document.documentElement;
        d.setAttribute("data-js", "");
        try {
          const t = localStorage.getItem("theme-preference");
          if (t === "light" || t === "dark") {
            d.setAttribute("data-theme", t);
          }
        } catch {
          /* noop */
        }
      })();
    </script>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:type" content={ogType} />

    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t(locale, "nav.skipLink")}
    </a>

    <Header locale={locale} path={path} section={section} />

    <main id="main">
      <slot />
    </main>

    <Footer locale={locale} section={section} />

    {/*
      Theme toggle, part 2 of 2: wires the click handler. Reads its localized
      labels from the button's own `data-label-*` attributes (set by
      ThemeToggle.astro) so this script's text also stays byte-for-byte
      identical on every page and in both locales.
    */}
    <script is:inline>
      (function () {
        const KEY = "theme-preference";
        const ORDER = ["system", "light", "dark"];
        const btn = document.getElementById("theme-toggle");
        if (!btn) return;
        function apply(state) {
          if (state === "system") {
            document.documentElement.removeAttribute("data-theme");
          } else {
            document.documentElement.setAttribute("data-theme", state);
          }
          btn.setAttribute("data-state", state);
          const label = btn.querySelector(".theme-toggle-label");
          if (label)
            label.textContent = btn.getAttribute("data-label-" + state) || "";
        }
        let current = "system";
        try {
          current = localStorage.getItem(KEY) || "system";
        } catch {
          /* noop */
        }
        apply(current);
        btn.addEventListener("click", function () {
          current = ORDER[(ORDER.indexOf(current) + 1) % ORDER.length];
          try {
            localStorage.setItem(KEY, current);
          } catch {
            /* noop */
          }
          apply(current);
        });
      })();
    </script>
  </body>
</html>
