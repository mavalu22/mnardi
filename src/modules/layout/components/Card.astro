---
// Shared card: a single <a> wrapping an optional eyebrow, a heading and a
// text slot (05-design-spec.md §8 "Card"). Cards are native links around a
// heading, never a <div onclick>, per the accessibility semantics rule (§12).
interface Props {
  href: string;
  heading: string;
  eyebrow?: string;
}

const { href, heading, eyebrow } = Astro.props;
---

<a class="card" href={href}>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h3>{heading}</h3>
  <p>
    <slot />
  </p>
</a>

<style>
  .card {
    position: relative;
    display: block;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    box-shadow: var(--elevation-sm);
    padding: var(--space-5);
    padding-top: calc(var(--space-5) + 2px);
    text-decoration: none;
    color: var(--color-text-primary);
    transition:
      box-shadow 150ms,
      border-color 150ms;
    overflow: hidden;
  }
  .card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--gradient-accent-bar);
    opacity: 0.55;
    transition: opacity 150ms;
  }
  .card:hover {
    box-shadow: var(--elevation-md);
    border-color: var(--color-border-input);
  }
  .card:hover::before {
    opacity: 1;
  }
  .card:active {
    box-shadow: var(--elevation-sm);
    border-color: var(--color-border-default);
  }
  .card:active::before {
    opacity: 0.55;
  }
  .card:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }
  .card h3 {
    margin-bottom: var(--space-2);
    color: var(--color-text-primary);
  }
  .card p {
    margin: 0;
    color: var(--color-text-secondary);
  }
</style>
