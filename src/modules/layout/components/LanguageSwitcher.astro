---
// Header control: EN / PT-BR links, the current locale marked with
// aria-current="page", each pointing to the same page in the other locale
// (05-design-spec.md §8 "Language switcher", §11 s01).
import {
  locales,
  localizePath,
  t,
  type DictionaryKey,
  type Locale,
} from "../../i18n";

interface Props {
  locale: Locale;
  /** The current page's path (may already carry a locale prefix). */
  path: string;
}

const { locale, path } = Astro.props;

const labelKeys: Record<Locale, DictionaryKey> = {
  en: "languageSwitcher.en",
  "pt-br": "languageSwitcher.ptBr",
};
---

<nav
  class="language-switcher"
  aria-label={t(locale, "languageSwitcher.ariaLabel")}
>
  {locales.map((candidate, index) => (
    <>
      {index > 0 && (
        <span class="divider" aria-hidden="true">
          /
        </span>
      )}
      <a
        href={localizePath(path, candidate)}
        aria-current={candidate === locale ? "page" : undefined}
      >
        {t(locale, labelKeys[candidate])}
      </a>
    </>
  ))}
</nav>

<style>
  /* Pill treatment (05-design-spec.md §8 "Locale switcher"): the current
     language is implied by word order (EN / PT-BR vs PT-BR / EN, set by
     `locales.ts`'s order and each dictionary's own labels), not by a
     separate active/inactive style pair — the underline-on-hover state
     below is the switcher's only visual state beyond the pill itself. */
  .language-switcher {
    display: flex;
    gap: var(--space-1);
    align-items: center;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    padding: 7px 9px;
    font-family: var(--font-family-mono);
    font-size: 10px;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.11em;
    color: var(--color-muted);
  }
  .language-switcher a {
    text-decoration: none;
    color: inherit;
  }
  .language-switcher a:hover {
    text-decoration: underline;
  }
  .language-switcher a[aria-current="page"] {
    color: var(--color-text);
  }
  .language-switcher .divider {
    color: var(--color-muted);
  }
</style>
