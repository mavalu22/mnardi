---
// Header control: cycles system -> light -> dark -> system on click
// (05-design-spec.md §8 "Theme toggle" — visual restyle only, behavior
// UNCHANGED from the shipped site, see §2; 03-platform-architecture.md §8).
//
// The button itself and its glyph are rendered by Astro (so labels are
// localized), but the two behaviours that make the toggle work — applying a
// stored choice before first paint, and wiring the click handler — live in
// two small inline scripts whose *text* must stay byte-for-byte identical on
// every page and in both locales (T-017 allowlists them in a CSP by
// SHA-256 hash). To keep them identical, neither script contains any
// interpolated value: the click-handler script reads its localized labels
// from `data-label-*` attributes set here by Astro, never from
// `define:vars` or template interpolation inside the script tag.
//
// The button starts hidden (`display: none`) and is revealed only once
// `data-js` is present on `<html>`, which the head script always sets — so
// with JavaScript disabled the toggle never appears (AC4) and with it
// enabled it appears with no flash, before body content paints.
import { t, type Locale } from "../../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<button
  type="button"
  class="theme-toggle"
  id="theme-toggle"
  data-state="system"
  data-label-system={t(locale, "themeToggle.system")}
  data-label-light={t(locale, "themeToggle.light")}
  data-label-dark={t(locale, "themeToggle.dark")}
>
  <span class="theme-toggle-glyph" aria-hidden="true">
    ◐
  </span>
  <span class="sr-only theme-toggle-label">
    {t(locale, "themeToggle.system")}
  </span>
</button>

<style>
  .theme-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-muted);
    cursor: pointer;
    transition:
      color 150ms,
      border-color 150ms,
      background-color 150ms;
  }
  :global(html[data-js]) .theme-toggle {
    display: inline-flex;
  }
  .theme-toggle:hover {
    color: var(--color-gold-text);
    border-color: var(--color-gold-accent);
  }
  .theme-toggle:active {
    background: var(--color-surface-2);
  }
  .theme-toggle-glyph {
    font-size: 16px;
    line-height: 1;
  }
  /* Glyph recolors per the current data-state (05-design-spec.md §8 "Theme toggle"),
     read by CSS only — the click-handler script only ever sets `data-state`, never a
     color, keeping the script's text unchanged (see the header comment above). */
  .theme-toggle[data-state="dark"] .theme-toggle-glyph,
  .theme-toggle[data-state="light"] .theme-toggle-glyph {
    color: var(--color-gold-text);
  }
</style>
