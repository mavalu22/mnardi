---
// Shared fallback-notice banner: informs a visitor that a page is showing
// the English version because no translation exists yet
// (05-design-spec.md §8 "Fallback-notice banner"). Text is a slot so each
// caller supplies its own localized copy (§13 tone of voice).
---

<div class="fallback-notice">
  <svg
    class="icon"
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
  >
    <circle cx="12" cy="12" r="9"></circle>
    <path d="M3 12h18M12 3c2.5 2.7 4 6 4 9s-1.5 6.3-4 9c-2.5-2.7-4-6-4-9s1.5-6.3 4-9z"></path>
  </svg>
  <p>
    <slot />
  </p>
</div>

<style>
  .fallback-notice {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    background: var(--color-surface-raised);
    border-left: 4px solid var(--color-info);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
    color: var(--color-text-primary);
    font-size: var(--font-size-sm);
  }
  .fallback-notice .icon {
    width: var(--icon-size-md);
    height: var(--icon-size-md);
    flex-shrink: 0;
    color: var(--color-info);
    margin-top: 2px;
  }
  .fallback-notice p {
    margin: 0;
  }
  .fallback-notice :global(a) {
    color: inherit;
    text-decoration: underline;
  }
</style>
