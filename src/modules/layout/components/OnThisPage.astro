---
// OnThisPage (05-design-spec.md §8 "Sticky 'On this page' side index"): a
// labelled nav of in-page heading links, sticky above 940px, static (inline,
// non-sticky) at 940px and below (§9). Props-only: the caller (project/
// article page) supplies the heading list it already extracted from its
// own rendered content.
interface HeadingLink {
  id: string;
  text: string;
}

interface Props {
  label: string;
  headings: HeadingLink[];
}

const { label, headings } = Astro.props;
---

{headings.length > 0 && (
  <nav class="on-this-page" aria-label={label}>
    <p class="on-this-page-label">{label}</p>
    <ul>
      {headings.map((heading) => (
        <li>
          <a href={`#${heading.id}`}>{heading.text}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .on-this-page {
    position: sticky;
    top: 106px;
    height: max-content;
    border-left: 1px solid var(--color-line);
    padding-left: 18px;
  }
  .on-this-page-label {
    margin: 0 0 8px 0;
    font-family: var(--font-family-mono);
    font-size: 10px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-faint);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .on-this-page ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .on-this-page a {
    display: block;
    color: var(--color-muted);
    font-size: 13px;
    padding: 5px 0;
    text-decoration: none;
  }
  .on-this-page a:hover {
    color: var(--color-gold-text);
  }

  @media (max-width: 940px) {
    .on-this-page {
      position: static;
    }
  }
</style>
