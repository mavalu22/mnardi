---
// MetaGrid (05-design-spec.md §8 "Meta box"): 1-4 label/value boxes, used on
// the project-detail hero (Role/Status/Stack/Sync). Props-only.
interface MetaItem {
  label: string;
  value: string;
}

interface Props {
  items: MetaItem[];
}

const { items } = Astro.props;
---

<dl class="meta-grid">
  {items.map((item) => (
    <div class="meta-box">
      <dt>{item.label}</dt>
      <dd>{item.value}</dd>
    </div>
  ))}
</dl>

<style>
  .meta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin: 0;
  }
  .meta-box {
    padding: 15px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-meta-box);
    background: var(--color-surface);
  }
  .meta-box dt {
    display: block;
    color: var(--color-muted);
    font-family: var(--font-family-mono);
    font-size: 9px;
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .meta-box dd {
    display: block;
    margin: 4px 0 0 0;
    font-size: 13px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .meta-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
