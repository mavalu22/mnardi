---
// Project detail page (03-platform-architecture.md §4 "<ProjectPage entry>";
// 05-design-spec.md §11 s03). Project hero (eyebrow "Project NN / category",
// title, description, meta grid), full-width cover, then the Markdown body
// in `Prose` beside a sticky `OnThisPage` index built from the body's own
// `##` headings. Wraps the entry's own content in a `lang="en"` region with
// a fallback notice above it when the entry has no pt-BR translation
// (ADR-007, design spec §12).
import { Image } from "astro:assets";
import {
  BaseLayout,
  Button,
  FallbackNotice,
  MetaGrid,
  Prose,
  OnThisPage,
} from "../layout";
import { localizePath, t } from "../i18n";
import { getProjects, renderProject, type Project } from "../content";

interface Props {
  entry: Project;
}

const { entry } = Astro.props;

const path = localizePath(`/projects/${entry.slug}/`, entry.locale);
const rendered = await renderProject(entry.slug, entry.locale);
if (!rendered) {
  throw new Error(
    `ProjectPage: no renderable entry for slug "${entry.slug}" (internal error)`,
  );
}
const { Content, headings } = rendered;

// NN is the project's position in the listing (design spec §11 s03), not the
// frontmatter `order` value itself: `getProjects` is the single source of
// truth for that ordering (manual `order` then English title).
const projects = await getProjects(entry.locale);
const position =
  projects.findIndex((project) => project.slug === entry.slug) + 1;
const positionLabel = String(position).padStart(2, "0");
const eyebrowText = entry.category
  ? `${t(entry.locale, "project.eyebrowLabel")} ${positionLabel} / ${entry.category}`
  : `${t(entry.locale, "project.eyebrowLabel")} ${positionLabel}`;

// Content-schema URLs (`links.repo`/`links.demo`) are validated with `z.string().url()`, which
// accepts any scheme (T-004 SEC finding). Only render a URL as a real link when it is http(s).
const isHttpUrl = (url: string) => /^https?:\/\//.test(url);
const repoHref =
  entry.links.repo && isHttpUrl(entry.links.repo)
    ? entry.links.repo
    : undefined;
const demoHref =
  entry.links.demo && isHttpUrl(entry.links.demo)
    ? entry.links.demo
    : undefined;

const contentLang = entry.isFallback ? "en" : undefined;

// SVG covers (T-018's interim prototype art) can't be rasterized to webp without
// `image.dangerouslyProcessSVG` (Astro's SVG optimization pipeline is opt-in for security); pass
// them through unchanged instead. Raster covers (the screenshots that replace them later) keep
// the existing webp conversion, no code change needed then (03-platform-architecture.md §5).
const coverFormat = entry.cover?.format === "svg" ? "svg" : "webp";
---

<BaseLayout
  locale={entry.locale}
  title={`${entry.title} — Matheus Nardi`}
  description={entry.description}
  path={path}
  fallback={entry.isFallback}
>
  <div class="container project-page">
    {entry.isFallback && (
      <div class="fallback-notice-wrap">
        <FallbackNotice>
          {t(entry.locale, "fallbackNotice.message")}
        </FallbackNotice>
      </div>
    )}

    <div lang={contentLang}>
      <section class="project-hero">
        <div class="project-hero-copy">
          <span class="eyebrow">{eyebrowText}</span>
          <h1>{entry.title}</h1>
          <p class="desc">{entry.description}</p>

          {(repoHref || demoHref) && (
            <div class="hero-links">
              {repoHref && (
                <Button variant="outlined" href={repoHref} target="_blank">
                  {t(entry.locale, "project.repoLink")}
                  <span class="sr-only">
                    {t(entry.locale, "a11y.opensInNewTab")}
                  </span>
                </Button>
              )}
              {demoHref && (
                <Button variant="outlined" href={demoHref} target="_blank">
                  {t(entry.locale, "project.demoLink")}
                  <span class="sr-only">
                    {t(entry.locale, "a11y.opensInNewTab")}
                  </span>
                </Button>
              )}
            </div>
          )}
        </div>

        {entry.meta && entry.meta.length > 0 && <MetaGrid items={entry.meta} />}
      </section>

      {entry.cover && (
        <div class="project-cover">
          <Image
            src={entry.cover}
            alt={entry.coverAlt ?? ""}
            width={entry.cover.width}
            height={entry.cover.height}
            format={coverFormat}
          />
        </div>
      )}

      <div class="content-layout">
        <Prose>
          <Content />
        </Prose>
        <OnThisPage
          label={t(entry.locale, "onThisPage.projectLabel")}
          headings={headings}
        />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .project-page {
    padding-top: var(--space-6);
  }
  .fallback-notice-wrap {
    margin-bottom: var(--space-5);
  }
  .project-hero {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: var(--space-9);
    align-items: end;
    padding-bottom: var(--space-6);
  }
  .desc {
    font-size: 18px;
    color: var(--color-muted);
    max-width: 47.5rem;
  }
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .project-cover {
    margin-top: var(--space-7);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-feature);
    overflow: hidden;
    box-shadow: var(--elevation-hover);
  }
  .project-cover :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .content-layout {
    display: grid;
    grid-template-columns: minmax(0, 760px) 240px;
    gap: var(--space-9);
    margin-top: var(--space-8);
  }

  @media (max-width: 940px) {
    .project-hero {
      grid-template-columns: 1fr;
      align-items: start;
      gap: var(--space-6);
    }
    .content-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 48px;
    }
  }
</style>
