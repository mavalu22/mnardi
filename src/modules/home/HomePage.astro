---
// Home screen (05-design-spec.md §11 s01; 03-platform-architecture.md §4
// "<HomePage>", depends on `layout`, `content`, `i18n`, `site`). Replaces
// T-014's résumé-shaped layout entirely (T-021 notes): hero (photo, eyebrow,
// "Software/AI Engineer" H1, one-sentence intro, three buttons, aside with
// Focus/Core/Based rows), a "01 / Projects" section (one featured project +
// up to 3 more as compact rows), a "02 / Writing" section (up to 3 newest
// posts as rows) and a "03 / Contact" block. The Projects section is
// omitted entirely with zero projects, the Writing section with zero posts
// (05-design-spec.md §8 "Featured-project block"/"Compact project/writing
// row", T-021 AC5) — Home no longer uses the retired `Card` component.
import { Image } from "astro:assets";
import { BaseLayout, Button, EntryRow, SectionHead, Tag } from "../layout";
import { formatYearMonth, localizePath, t, type Locale } from "../i18n";
import { getProjects, getPosts } from "../content";
import { siteProfile, profileFor } from "../site";

interface Props {
  locale: Locale;
  /** The current page's path, including any locale prefix it already has. */
  path: string;
}

const { locale, path } = Astro.props;
const text = profileFor(siteProfile, locale);

const [projects, posts] = await Promise.all([
  getProjects(locale),
  getPosts(locale),
]);

const featuredProject = projects[0];
const otherProjects = projects.slice(1, 4);
const featuredPosts = posts.slice(0, 3);

/** `<time datetime>` value for a post's date (mirrors the blog module's own `isoDate` helper;
 * duplicated rather than imported since `blog` doesn't export it through its public interface,
 * 04-stack-profile.md §1 module boundary). */
function isoDate(date: Date): string {
  return date.toISOString().slice(0, 10);
}

const title = "Matheus Nardi — Software/AI Engineer";
---

<BaseLayout locale={locale} title={title} description={text.intro} path={path}>
  <div class="container">
    <section class="hero">
      <div class="hero-main">
        <div class="hero-id">
          <Image
            class="hero-photo"
            src={siteProfile.photo}
            alt={text.photoAlt}
            width={52}
            height={52}
            format="avif"
          />
          <p class="eyebrow hero-eyebrow">Software / AI Engineer</p>
        </div>
        <h1 class="home-title">
          Software/AI <span class="gold">Engineer</span>
        </h1>
        <p class="lead hero-intro">{text.intro}</p>
        <div class="hero-links">
          <Button variant="primary" href={siteProfile.linkedin} target="_blank">
            {t(locale, "home.linkedinButton")}
          </Button>
          <Button variant="outlined" href={text.resume}>
            {t(locale, "home.resumeButton")}
          </Button>
          <Button variant="outlined" href={siteProfile.github} target="_blank">
            {t(locale, "home.githubButton")}
          </Button>
        </div>
      </div>

      <aside class="hero-aside">
        <p>{text.asideNote}</p>
        <div class="mono-list">
          <div class="mono-row">
            <span>{t(locale, "home.focusLabel")}</span>
            <strong>{text.focus}</strong>
          </div>
          <div class="mono-row">
            <span>{t(locale, "home.coreLabel")}</span>
            <strong>{text.core}</strong>
          </div>
          <div class="mono-row">
            <span>{t(locale, "home.basedLabel")}</span>
            <strong>{text.based}</strong>
          </div>
        </div>
      </aside>
    </section>

    {featuredProject && (
      <section class="section">
        <SectionHead
          eyebrow={t(locale, "home.projectsEyebrow")}
          title={t(locale, "home.projectsTitle")}
          linkHref={localizePath("/projects/", locale)}
          linkLabel={t(locale, "sectionHead.viewAllProjects")}
        />

        <a
          class="project-feature"
          href={localizePath(`/projects/${featuredProject.slug}/`, locale)}
        >
          <div class="project-feature-copy">
            <p class="project-index">
              {t(locale, "home.featuredLabelPrefix")}
              {(featuredProject.topics ?? []).join(" / ")}
            </p>
            <h3>{featuredProject.title}</h3>
            <p>{featuredProject.description}</p>
            {featuredProject.techStack.length > 0 && (
              <div class="project-meta">
                {featuredProject.techStack.map((tech) => (
                  <Tag>{tech}</Tag>
                ))}
              </div>
            )}
            <span class="btn-static">{t(locale, "home.openProject")}</span>
          </div>
          {featuredProject.cover && (
            <div class="project-feature-media">
              <Image
                src={featuredProject.cover}
                alt={featuredProject.coverAlt ?? ""}
                width={600}
                height={400}
              />
            </div>
          )}
        </a>

        {otherProjects.length > 0 && (
          <div class="project-list">
            {otherProjects.map((project, index) => (
              <EntryRow
                variant="project"
                href={localizePath(`/projects/${project.slug}/`, locale)}
                number={String(index + 2).padStart(2, "0")}
                title={project.title}
                description={project.description}
                meta={project.techStack}
              />
            ))}
          </div>
        )}
      </section>
    )}

    {featuredPosts.length > 0 && (
      <section class="section">
        <SectionHead
          eyebrow={t(locale, "home.writingEyebrow")}
          title={t(locale, "home.writingTitle")}
          linkHref={localizePath("/blog/", locale)}
          linkLabel={t(locale, "sectionHead.viewAllWriting")}
        />

        <div class="writing-list">
          {featuredPosts.map((post) => (
            <EntryRow
              variant="writing"
              href={localizePath(`/blog/${post.slug}/`, locale)}
              date={formatYearMonth(post.date, locale)}
              dateTime={isoDate(post.date)}
              title={post.title}
              description={post.summary}
              meta={post.topics ?? []}
            />
          ))}
        </div>
      </section>
    )}

    <section class="section">
      <div class="contact-block">
        <p class="eyebrow">{t(locale, "home.contactEyebrow")}</p>
        <a class="contact-email" href={`mailto:${siteProfile.email}`}>
          {siteProfile.email}
        </a>
        <p class="contact-note">{t(locale, "home.contactNote")}</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: var(--space-9);
    align-items: end;
    min-height: 590px;
    padding-bottom: var(--space-9);
  }

  .hero-id {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .hero-eyebrow {
    margin: 0;
  }
  .hero-photo {
    display: block;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-pill);
    object-fit: cover;
    border: 1px solid var(--color-line);
    box-shadow: 0 0 0 3px var(--color-gold-soft);
  }

  .home-title {
    font-size: var(--font-size-home-title);
    line-height: 0.91;
    letter-spacing: -0.065em;
    max-width: 900px;
    margin: 0 0 var(--space-5) 0;
  }
  .home-title .gold {
    color: var(--color-gold-text);
  }

  .hero-intro {
    max-width: 720px;
    margin: 0;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: var(--space-6);
  }

  .hero-aside {
    border-left: 1px solid var(--color-line);
    padding-left: var(--space-6);
  }
  .hero-aside p {
    margin: 0 0 var(--space-5) 0;
    color: var(--color-muted);
    font-size: 14px;
  }
  .mono-list {
    display: grid;
  }
  .mono-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 13px 0;
    border-top: 1px solid var(--color-line);
    font-size: 12px;
  }
  .mono-row:last-child {
    border-bottom: 1px solid var(--color-line);
  }
  .mono-row span:first-child {
    color: var(--color-muted);
    font-family: var(--font-family-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .mono-row strong {
    font-size: 12px;
    font-weight: var(--font-weight-semibold);
  }

  .section {
    padding: var(--space-7) 0 var(--space-8);
  }

  .project-feature {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-feature);
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    transition:
      border-color 220ms,
      box-shadow 220ms,
      transform 220ms;
  }
  .project-feature:hover {
    border-color: color-mix(
      in srgb,
      var(--color-gold-accent) 55%,
      var(--color-line)
    );
    box-shadow: var(--elevation-hover);
    transform: translateY(-2px);
  }

  .project-feature-copy {
    padding: var(--space-7);
  }
  .project-index {
    margin: 0;
    font-family: var(--font-family-mono);
    font-size: 10px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-gold-text);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .project-feature h3 {
    font-size: var(--font-size-feature-title);
    line-height: 1;
    letter-spacing: -0.045em;
    margin: var(--space-4) 0;
  }
  .project-feature-copy > p {
    margin: 0;
    color: var(--color-muted);
    max-width: 600px;
  }
  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-5) 0 var(--space-6) 0;
  }
  .btn-static {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    border-radius: var(--radius-button);
    padding: 11px 15px;
    font-size: 13px;
    font-weight: var(--font-weight-bold);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    color: var(--color-text);
  }
  .project-feature-media {
    min-height: 340px;
    background: #0d100c;
    border-left: 1px solid var(--color-line);
    display: flex;
    align-items: stretch;
  }
  .project-feature-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-list {
    display: grid;
    border-top: 1px solid var(--color-line);
  }

  .writing-list {
    border-top: 1px solid var(--color-line);
  }

  .contact-block {
    border: 1px solid
      color-mix(in srgb, var(--color-gold-accent) 54%, var(--color-line));
    background: color-mix(
      in srgb,
      var(--color-surface) 85%,
      var(--color-gold-accent) 3%
    );
    border-radius: var(--radius-feature);
    padding: var(--space-6) var(--space-7);
  }
  .contact-block .eyebrow {
    margin-bottom: var(--space-4);
  }
  .contact-email {
    display: inline-block;
    font-size: clamp(24px, 3vw, 32px);
    letter-spacing: -0.035em;
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-gold-accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 7px;
  }
  .contact-note {
    margin: var(--space-2) 0 0 0;
    color: var(--color-muted);
    font-size: 13px;
  }

  @media (max-width: 940px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: var(--space-8);
      padding-bottom: var(--space-8);
    }
    .hero-aside {
      border-left: 0;
      border-top: 1px solid var(--color-line);
      padding-left: 0;
      padding-top: var(--space-5);
    }
    .project-feature {
      grid-template-columns: 1fr;
    }
    .project-feature-media {
      border-left: 0;
      border-top: 1px solid var(--color-line);
      min-height: 290px;
    }
  }

  @media (max-width: 640px) {
    .home-title {
      font-size: 52px;
    }
    .hero-intro {
      font-size: 17px;
    }
    .project-feature-copy {
      padding: var(--space-6);
    }
    .project-feature h3 {
      font-size: 34px;
    }
    .contact-block {
      padding: var(--space-5);
    }
    .contact-note {
      margin-top: var(--space-4);
    }
  }
</style>
