---
// Home screen (05-design-spec.md §11 s01; 03-platform-architecture.md §4
// "<HomePage>", depends on `layout`, `content`, `site`, `i18n`). Renders the
// profile photo, name (the page's only <h1>), headline, bio, contact links,
// resume link and, below the hero, a "top project" / "latest post" highlight
// section built from the shared Card component. Each highlight card is
// omitted entirely when its content type has zero entries (design spec §8
// "Card, Home-highlight variant", US-04 AC5).
import { Image } from "astro:assets";
import { BaseLayout, Card } from "../layout";
import { localizePath, t, type Locale } from "../i18n";
import { getProjects, getPosts } from "../content";
import { siteProfile, profileFor } from "../site";

interface Props {
  locale: Locale;
  /** The current page's path, including any locale prefix it already has. */
  path: string;
}

const { locale, path } = Astro.props;
const text = profileFor(siteProfile, locale);

const [projects, posts] = await Promise.all([
  getProjects(locale),
  getPosts(locale),
]);
const topProject = projects[0];
const latestPost = posts[0];
---

<BaseLayout
  locale={locale}
  title={`${siteProfile.name} — ${text.headline}`}
  description={text.bio}
  path={path}
>
  <div class="container">
    <section class="hero">
      <svg
        class="hero-accent-motif"
        aria-hidden="true"
        viewBox="0 0 100 100"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <rect
          x="10"
          y="10"
          width="55"
          height="55"
          rx="10"
          transform="rotate(-8 37 37)"
        ></rect>
        <circle cx="78" cy="70" r="16"></circle>
      </svg>

      <div class="hero-photo">
        <Image
          src={siteProfile.photo}
          alt={text.photoAlt}
          width={200}
          height={200}
          format="webp"
        />
      </div>

      <div class="hero-content">
        <h1>{siteProfile.name}</h1>
        <p class="headline">{text.headline}</p>
        <p class="lead">{text.bio}</p>

        <h2 class="eyebrow">{t(locale, "eyebrow.getInTouch")}</h2>
        <ul class="contact-links">
          <li>
            <a href={`mailto:${siteProfile.email}`}>
              <svg
                class="icon"
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                <path d="m3 7 9 6 9-6"></path>
              </svg>
              {siteProfile.email}
            </a>
          </li>
          <li>
            <a href={siteProfile.linkedin} target="_blank" rel="noopener">
              <svg
                class="icon"
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                <path d="M7 10v7M7 7v.01M11 17v-4.5a1.5 1.5 0 0 1 3 0V17M14 12.5a1.5 1.5 0 0 1 3 0V17"></path>
              </svg>
              LinkedIn
              <span class="sr-only">{t(locale, "a11y.opensInNewTab")}</span>
            </a>
          </li>
          <li>
            <a href={siteProfile.github} target="_blank" rel="noopener">
              <svg
                class="icon"
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2-.2 4.5-1 4.5-4.5 0-1-.4-2-1-2.7.1-.3.4-1.4 0-2.8 0 0-1 0-3 1.3a10 10 0 0 0-5 0C7 5.6 6 5.6 6 5.6c-.4 1.4-.1 2.5 0 2.8-.6.7-1 1.7-1 2.7 0 3.5 2.5 4.3 4.5 4.5-.4.4-.5.9-.5 1.5V21"></path>
              </svg>
              GitHub
              <span class="sr-only">{t(locale, "a11y.opensInNewTab")}</span>
            </a>
          </li>
        </ul>

        <p class="resume-cta">
          <a
            class="btn-primary"
            href={text.resume}
            target="_blank"
            rel="noopener"
          >
            <svg
              class="icon"
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"></path>
            </svg>
            {t(locale, "home.viewResume")}
          </a>
        </p>
      </div>
    </section>

    {(topProject || latestPost) && (
      <section class="home-highlights" aria-labelledby="highlights-heading">
        <h2 id="highlights-heading" class="sr-only">
          {t(locale, "home.highlightsHeading")}
        </h2>
        <ul class="highlight-grid">
          {topProject && (
            <li>
              <Card
                href={localizePath(`/projects/${topProject.slug}/`, locale)}
                heading={topProject.title}
                eyebrow={t(locale, "eyebrow.topProject")}
              >
                {topProject.description}
              </Card>
            </li>
          )}
          {latestPost && (
            <li>
              <Card
                href={localizePath(`/blog/${latestPost.slug}/`, locale)}
                heading={latestPost.title}
                eyebrow={t(locale, "eyebrow.latestPost")}
              >
                {latestPost.summary}
              </Card>
            </li>
          )}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-top: var(--space-7);
    padding-bottom: var(--space-7);
    overflow: hidden;
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--gradient-hero-glow);
  }

  .hero-accent-motif {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    width: 5rem;
    height: 5rem;
    color: var(--color-accent-text);
    opacity: 0.5;
    z-index: -1;
  }

  .hero-photo img {
    display: block;
    width: 160px;
    height: 160px;
    border-radius: var(--radius-full);
    object-fit: cover;
    border: 1px solid var(--color-border-input);
  }

  .hero-content {
    max-width: 42rem;
  }

  .headline {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    list-style: none;
    margin: 0 0 var(--space-6) 0;
    padding: 0;
  }
  .contact-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-primary);
    text-decoration: none;
  }
  .contact-links a:hover {
    color: var(--color-brand-text);
    text-decoration: underline;
  }

  .icon {
    width: var(--icon-size-md);
    height: var(--icon-size-md);
    flex-shrink: 0;
  }

  .resume-cta {
    margin: 0;
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-brand-fill);
    color: var(--color-text-inverse);
    text-decoration: none;
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-weight: var(--font-weight-medium);
    transition: background 150ms;
  }
  .btn-primary:hover {
    background: var(--color-brand-fill-hover);
  }

  .home-highlights {
    padding-bottom: var(--space-8);
  }
  .highlight-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-5);
    list-style: none;
    margin: var(--space-7) 0 0 0;
    padding: 0;
  }

  @media (min-width: 640px) {
    .hero {
      flex-direction: row;
      align-items: flex-start;
    }
    .hero-photo {
      flex: 0 0 auto;
    }
  }

  @media (min-width: 1024px) {
    .hero-photo img {
      width: 200px;
      height: 200px;
    }
  }
</style>
